# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb://127.0.0.1:27017/chefPortfolio

# JWT Secret (at least 16 characters)
JWT_SECRET=chef_imam_secret_jwt_key_2026_secure

# Allowed Client Origin (separated by commas for multiple)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Cookie SameSite setting ('lax' for localhost or same root domain, 'none' for separate cross-domain with SSL)
COOKIE_SAMESITE=lax

# Initial Admin Credentials (for seed:admin)
ADMIN_EMAIL=admin@chefimam.com
ADMIN_PASSWORD=ChefImam@2026

# Cloudinary Credentials (Optional - for image upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
